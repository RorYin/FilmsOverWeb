# FilmsOverWeb Environment Configuration Example

# Server Secret Key for JWT Authentication
SECRET_KEY=films-over-web-super-secret-key-change-me-2026

# JSON Database Location (On Render with a Persistent Disk mounted at /data, set: DATABASE_FILE=/data/films_over_web.json)
DATABASE_FILE=films_over_web.json

# SuperAdmin Credentials (Optional: if set, password change prompt is bypassed. If omitted, falls back to test@gmail.com / 1q2w3e4r5t with first-time change prompt)
SuperAdminEmail=
SuperAdminPassword=

# TMDB (The Movie Database) API Key (Can also be set in SuperAdmin UI)
TMDB_API_KEY=

# Cloudflare Stream Worker for Zero-Bandwidth Direct Streaming (Option B)
CLOUDFLARE_WORKER_URL=

# Google Drive Folders (Comma-separated list of folder URLs to automatically sync on every Render deployment/startup)
DRIVE_FOLDER_URLS=
DEFAULT_DRIVE_FOLDER_URL=
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Mail Automation (Gmail SMTP for Guest Invites & Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
