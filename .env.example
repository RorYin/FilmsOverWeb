# FilmsOverWeb Environment Configuration Example

# Server Secret Key for JWT Authentication
SECRET_KEY=films-over-web-super-secret-key-change-me-2026

# SQLite Database Location
DATABASE_URL=sqlite:///./films_over_web.db

# Initial SuperAdmin Credentials
DEFAULT_SUPERADMIN_EMAIL=drmnbot@gmail.com
DEFAULT_SUPERADMIN_PASSWORD=SuperAdmin@2026

# TMDB (The Movie Database) API Key (Can also be set in SuperAdmin UI)
TMDB_API_KEY=

# Google Drive API Key or Service Account JSON (Can also be set in SuperAdmin UI)
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Mail Automation (Gmail SMTP for Guest Invites)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=drmnbot@gmail.com
SMTP_PASSWORD=
SMTP_USE_SSL=true
