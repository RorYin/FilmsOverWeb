# FilmsOverWeb Environment Configuration Example

# Server Secret Key for JWT Authentication
SECRET_KEY=films-over-web-super-secret-key-change-me-2026

# JSON Database Location
DATABASE_FILE=films_over_web.json

# Initial SuperAdmin Credentials
DEFAULT_SUPERADMIN_EMAIL=test@gmail.com
DEFAULT_SUPERADMIN_PASSWORD=1q2w3e4r5t

# TMDB (The Movie Database) API Key (Can also be set in SuperAdmin UI)
TMDB_API_KEY=

# Cloudflare Stream Worker for Zero-Bandwidth Direct Streaming (Option B)
CLOUDFLARE_WORKER_URL=

# Google Drive Folder (Pre-configured default, Admins can add more)
DEFAULT_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1JeQk11TthFV5QgfkBtnrbrQHbZn1x5YT?usp=sharing
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Mail Automation (Gmail SMTP for Guest Invites & Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
